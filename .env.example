# ===================================================================
# Immich-Zugang
# ===================================================================
# Mit oder ohne /api am Ende - beides wird erkannt.
IMMICH_URL=http://192.168.0.189:30041
# API-Key des Kontos, dessen Videos bearbeitet werden sollen.
# Immich: Kontoeinstellungen -> API-Keys -> Neuer Key
IMMICH_API_KEY=

# ===================================================================
# Auswahl: welche Videos ueberhaupt angefasst werden
# ===================================================================
# Ab dieser kurzen Kante gilt das Material als gut genug.
SKIP_IF_SHORT_EDGE_GTE=2160
# Ab dieser Bitrate ebenfalls - ein Neukodieren waere dort ein Verlustgeschaeft.
SKIP_IF_MBIT_GTE=45
# Ziel fuer die kurze Kante beim Hochskalieren.
TARGET_SHORT_EDGE=1080
# Obergrenze fuer den Vergroesserungsfaktor. 176x144 auf 4K zu ziehen bringt nichts.
MAX_SCALE=4
# Nur Favoriten bearbeiten - sinnvoll fuer einen ersten scharfen Lauf.
ONLY_FAVORITES=false

# ===================================================================
# Verarbeitung
# ===================================================================
# BasicVSR++ Modell. 6 = NTIRE 2021 Compressed Video Track 3 (Standard,
# temporal, gegen Kompressionsschaeden). 9 = Denoising, 4/5 = andere
# Kompressionsstufen, 0-3 = Super-Resolution.
VS_MODEL=6
# Frames je Sequenzblock. Hoeher = besserer temporaler Zusammenhang, mehr VRAM.
VS_LENGTH=15
# Raeumliche Kachelung bei grossen Bildern (0 = aus). Bei VRAM-Mangel z.B. 512.
VS_TILE=0
# Zwischenergebnisse in den Hauptspeicher auslagern: spart VRAM, kostet Tempo.
VS_CPU_CACHE=false
# Restauration abschalten und nur skalieren (zum Vergleichen).
RESTORE=true

# ===================================================================
# Encoder
# ===================================================================
ENCODER=hevc_nvenc
PRESET=p6
CQ=22
# Abbruch, wenn ein einzelnes Video laenger braucht (Sekunden).
JOB_TIMEOUT=7200

# ===================================================================
# Kennzeichnung von KI-bearbeitetem Material
# ===================================================================
# Dauerhaft eingebrannt und bewusst so: das Original bleibt als gestapeltes
# Asset erhalten, die bearbeitete Fassung soll erkennbar bleiben.
WATERMARK_ENABLED=true
WATERMARK_TEXT=AI
WATERMARK_ALPHA=0.35
# Zusaetzlich als Immich-Tag, damit bearbeitete Videos auffindbar sind.
TAG_NAME=AI-enhanced

# ===================================================================
# Betrieb
# ===================================================================
# true = alles rechnen, aber nichts hochladen. Zum Ausprobieren.
DRY_RUN=true
NIGHT_START=01:15
NIGHT_END=06:15
# Zeitfenster ignorieren und durchgehend arbeiten.
IGNORE_TIME_WINDOW=false
# Hoechstens so viele Videos je Durchlauf (0 = unbegrenzt).
MAX_PER_RUN=0
# Einmalig setzen, nachdem eine Fehlerursache behoben wurde: verwirft die
# Fehlerzaehler, sodass abgeschriebene Videos wieder an die Reihe kommen.
RESET_FAILED=false
# Wartezeit, wenn nichts zu tun ist (Sekunden).
IDLE_SLEEP=300
